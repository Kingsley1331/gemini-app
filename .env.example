# =============================================================================
# gemini-app environment variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values:
#     cp .env.example .env.local
# NEVER commit `.env.local` (it is gitignored). This template contains
# placeholders only - do not put real secrets here.
#
# For a full explanation of what each variable does, see
# docs/DEVELOPER_SETUP.md.
# =============================================================================

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------

# Google Gemini API key. REQUIRED - this is the core provider and powers chat,
# image generation ("Nano Banana"), SVG assets, PWA icon generation, and
# text-to-speech. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API key. OPTIONAL - only needed to use the GPT models in the model
# picker (model IDs starting with "gpt-"). Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Anthropic API key. OPTIONAL - only needed to use the Claude models in the
# model picker (model IDs starting with "claude-"). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# remove.bg (background removal for transparent image assets)
# -----------------------------------------------------------------------------

# remove.bg API key. OPTIONAL - used to cut out backgrounds when a transparent
# asset is requested. If unset (or the call fails), the app falls back to a
# built-in heuristic flood-fill. Get one at https://www.remove.bg/api
REMOVE_BG_API_KEY=your-remove-bg-api-key

# -----------------------------------------------------------------------------
# Firebase Admin (Firestore + Storage) - persistence for shared/draft apps
# -----------------------------------------------------------------------------
# All four are REQUIRED together to enable publishing/sharing apps. They come
# from a Firebase service account JSON key. If any is missing, shared-install
# features are disabled and publish requests fail.

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# The service account private key. Keep the surrounding quotes and the literal
# "\n" sequences on a single line - the app converts "\n" back into real
# newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...your-key...==\n-----END PRIVATE KEY-----\n"

# The Cloud Storage bucket, e.g. your-project.appspot.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# -----------------------------------------------------------------------------
# Vercel Blob (storage for generated PWA icons)
# -----------------------------------------------------------------------------

# Vercel Blob read/write token. OPTIONAL - when set, generated PWA icons are
# cached in Blob storage (recommended for production/serverless where local
# tmp is ephemeral). If unset, icons fall back to in-memory/tmp storage.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# -----------------------------------------------------------------------------
# Feature flags - shareable PWA installs
# -----------------------------------------------------------------------------
# Set BOTH to "1" (or "true") to enable publishing and installing shared apps.
# The server flag gates the API; the NEXT_PUBLIC_ flag gates the client UI.
# Requires Firebase to be configured.

ENABLE_SHAREABLE_INSTALLS=0
NEXT_PUBLIC_ENABLE_SHAREABLE_INSTALLS=0
